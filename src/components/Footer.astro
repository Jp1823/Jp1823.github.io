---
import { useT, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const t = useT(Astro.props.lang);
const year = new Date().getFullYear();
---

<footer class="wrap">
	<span>© {year} João Abreu</span>
	<span>Braga, PT</span>
	<a href="https://github.com/Jp1823/Jp1823.github.io">{t('footer.source')}</a>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding-block: 1.5rem 2rem;
		border-top: 1px solid var(--line);
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--muted);
	}

	a {
		color: var(--muted);
		margin-left: auto;
	}
</style>
