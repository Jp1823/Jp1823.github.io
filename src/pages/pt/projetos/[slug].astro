---
import type { GetStaticPaths } from 'astro';
import ProjectPage from '../../../views/ProjectPage.astro';
import { getProjects, slugOf } from '../../../lib/content';

export const getStaticPaths = (async () => {
	const projects = await getProjects('pt');
	return projects.map((project) => ({ params: { slug: slugOf(project) }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
---

<ProjectPage lang="pt" project={project} />
