---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import { pathTo, useT, type Lang } from '../i18n/ui';
import { getCv, getProjects } from '../lib/content';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const cv = await getCv(lang);
const featured = (await getProjects(lang)).filter((p) => p.data.featured).slice(0, 3);
---

<Base lang={lang} title={cv.name} page="home">
	<section class="intro">
		<p class="label"><span class="accent">$</span> whoami</p>
		<h1>{cv.name}<span class="cursor" aria-hidden="true">_</span></h1>
		<p class="role">{cv.role}</p>
		<div class="text">
			{cv.intro.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<ul class="links" aria-label={t('home.contact')}>
			{
				cv.links.map((link) => (
					<li>
						<a href={link.url}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</section>

	{
		featured.length > 0 && (
			<section class="featured">
				<h2 class="label">
					<span class="accent">01 /</span> {t('home.featured')}
				</h2>
				<ProjectList lang={lang} projects={featured} />
				<p class="more">
					<a href={pathTo(lang, 'projects')}>{t('home.allProjects')} →</a>
				</p>
			</section>
		)
	}
</Base>

<style>
	.intro {
		margin-bottom: clamp(3.5rem, 10vw, 6rem);
	}

	h1 {
		font-size: clamp(2rem, 7vw, 3.25rem);
		margin: 0.5rem 0 0.75rem;
	}

	.cursor {
		color: var(--accent);
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.role {
		font-family: var(--mono);
		color: var(--muted);
		font-size: 0.9375rem;
		margin-bottom: 2rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		font-family: var(--mono);
		font-size: 0.875rem;
	}

	.links a::before {
		content: '↗ ';
		color: var(--accent);
	}

	.featured h2 {
		font-weight: 400;
		margin-bottom: 1rem;
	}

	.more {
		margin-top: 1.25rem;
		font-family: var(--mono);
		font-size: 0.875rem;
	}
</style>
